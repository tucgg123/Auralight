# Base de datos (local con docker compose, o la URL de Neon en producción)
DATABASE_URL=postgresql://auralight:auralight@localhost:5432/auralight

# Secretos para firmar los tokens (usa valores largos y aleatorios en producción)
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo

# Origen del sitio web, para CORS
WEB_ORIGIN=http://localhost:3000

# Administrador inicial que crea el seed
ADMIN_EMAIL=admin@auralight.co
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Santiago

# Cloudinary (opcional en local: sin esto, las piezas se muestran con ilustración)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=auralight

PORT=4000
